{
  "effortLevel": "high",
  "permissions": {
    "allow": [
      "Bash(cargo build*)",
      "Bash(cargo test*)",
      "Bash(cargo run*)",
      "Bash(cargo fmt*)",
      "Bash(cargo clippy*)",
      "Bash(cargo doc*)",
      "Bash(cargo check*)",

      "Bash(gradlew*)",
      "Bash(./gradlew*)",

      "Skill(caffeine-sweep)",
      "Skill(caffeine-sim)",

      "Edit(../caffeine/**)"
    ],
    "additionalDirectories": [
      "../caffeine",
      "C:/Users/yanivholder/Downloads/ThesisNew/caffeine",
      "C:/Users/yanivholder/.agents"
    ]
  },
  "env": {
    "CLAUDE_CODE_ADDITIONAL_DIRECTORIES_CLAUDE_MD": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/web-only.sh $CLAUDE_PROJECT_DIR/.claude/hooks/caffeine-warmup.sh"
          },
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/web-only.sh $CLAUDE_PROJECT_DIR/.claude/hooks/agents-setup.sh"
          }
        ]
      }
    ]
  }
}
