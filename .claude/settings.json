{
  "effortLevel": "high",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(cargo*)",
      "Bash(gradlew*)",
      "Bash(pytest*)",
      "Bash(.venv/bin/python -m pytest*)",
      "Bash(.venv/Scripts/python -m pytest*)",
      "Skill(full-validation)"
    ],
    "additionalDirectories": [
      "~/projects/caffeine",
      "/home/user/caffeine"
    ]
  }
}