# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
*.egg-info/
dist/
build/

# Evolution Run Artifacts (Transient)
# Everything an evolve run writes lands under outputs/ (cycles, ledger, logs,
# synthesis, leaderboard.md, rejection-log.md). Ignore the contents but
# preserve the directory layout via .gitkeep so a fresh clone shows it.
outputs/**
!outputs/**/
!outputs/**/.gitkeep
