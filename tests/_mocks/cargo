#!/usr/bin/env bash
# Mock cargo for evolve gate-script tests.
#
# Handles the cargo invocations made by src/evolve/variant/build.py and
# src/evolve/variant/gates/ (variant workspace `cargo build --tests`
# and `cargo test --test {contract_gate,universal_invariant_gate,invariant_gate}`)
# by scanning the overlaid workspace for marker comments — no real Rust
# compilation runs:
#
#   // MOCK_CARGO: build_gate_fail                            -> `cargo build --tests` fails
#   // MOCK_CARGO: contract_gate_fail                         -> `cargo test --test contract_gate` fails
#   // MOCK_CARGO: universal_invariant_gate_fail U<n> <name>  -> `cargo test --test universal_invariant_gate` fails
#   // MOCK_CARGO: invariant_gate_fail P<n> <name>            -> `cargo test --test invariant_gate` fails
#                                                                with the matching panic format
#
# Markers must appear at the start of a line in any `.rs` file under the
# workspace `src/` tree (so a variant overlaying any source file can trigger
# the appropriate gate failure).
#
# Any other cargo invocation (fitness plugins building real binaries, etc.)
# is forwarded to the real cargo found on PATH after stripping this shim's dir.
set -uo pipefail

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"

_delegate_to_real_cargo() {
    local real_path
    real_path=$(echo "$PATH" | tr ':' '\n' | grep -vxF "$SELF_DIR" | tr '\n' ':')
    real_path="${real_path%:}"
    local real_cargo
    real_cargo=$(PATH="$real_path" command -v cargo || true)
    if [ -z "$real_cargo" ]; then
        echo "mock cargo: no real cargo on PATH for passthrough: $*" >&2
        exit 127
    fi
    PATH="$real_path" exec "$real_cargo" "$@"
}

SUBCMD="${1:-}"
ALL_ARGS=("$@")
shift || true

# Detect gate-mode invocations by walking args.
IS_GATE_BUILD=false
IS_GATE_TEST=""
MANIFEST=""
ARGS=("$@")
i=0
while [ $i -lt ${#ARGS[@]} ]; do
    case "${ARGS[$i]}" in
        --manifest-path) MANIFEST="${ARGS[$((i+1))]}"; i=$((i+2));;
        --tests)         IS_GATE_BUILD=true; i=$((i+1));;
        --test)
            case "${ARGS[$((i+1))]}" in
                contract_gate|universal_invariant_gate|invariant_gate) IS_GATE_TEST="${ARGS[$((i+1))]}";;
            esac
            i=$((i+2));;
        *) i=$((i+1));;
    esac
done

if [ "$SUBCMD" = "build" ] && ! $IS_GATE_BUILD; then
    _delegate_to_real_cargo "${ALL_ARGS[@]}"
fi
if [ "$SUBCMD" = "test" ] && [ -z "$IS_GATE_TEST" ]; then
    _delegate_to_real_cargo "${ALL_ARGS[@]}"
fi
if [ "$SUBCMD" != "build" ] && [ "$SUBCMD" != "test" ]; then
    _delegate_to_real_cargo "${ALL_ARGS[@]}"
fi

WORK_DIR=""
if [ -n "$MANIFEST" ]; then
    WORK_DIR="$(dirname "$MANIFEST")"
fi

# Scan the workspace `src/` tree for marker comments. Returns the first match.
_first_marker() {
    local pattern="$1"
    [ -d "$WORK_DIR/src" ] || return 0
    grep -RhoE "$pattern" "$WORK_DIR/src" --include='*.rs' 2>/dev/null | head -n1
}

if [ "$SUBCMD" = "build" ]; then
    if [ -n "$(_first_marker '^// MOCK_CARGO: build_gate_fail')" ]; then
        echo "error[E0599]: mock cargo: build_gate_fail marker present in workspace src/" >&2
        exit 101
    fi
    exit 0
fi

case "$IS_GATE_TEST" in
    contract_gate)
        if [ -n "$(_first_marker '^// MOCK_CARGO: contract_gate_fail')" ]; then
            echo "thread 'main' panicked: contract gate failed (mock marker)" >&2
            exit 101
        fi
        exit 0
        ;;
    universal_invariant_gate)
        MARK=$(_first_marker '^// MOCK_CARGO: universal_invariant_gate_fail U[0-9]+ [a-z_]+')
        if [ -n "$MARK" ]; then
            INV="${MARK#// MOCK_CARGO: universal_invariant_gate_fail }"
            echo "thread 'main' panicked at tests/universal_invariant_gate.rs:1:1:" >&2
            echo "universal invariant violated: $INV" >&2
            exit 101
        fi
        exit 0
        ;;
    invariant_gate)
        MARK=$(_first_marker '^// MOCK_CARGO: invariant_gate_fail P[1-5] [a-z_]+')
        if [ -n "$MARK" ]; then
            INV="${MARK#// MOCK_CARGO: invariant_gate_fail }"
            echo "thread 'tokio-runtime-worker' panicked at evolve/harness/invariant_gate.rs:1:1:" >&2
            echo "invariant gate violated: $INV" >&2
            exit 101
        fi
        exit 0
        ;;
esac
exit 0
